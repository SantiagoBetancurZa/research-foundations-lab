# Copy to .env.local for `vercel dev`, or set these in Vercel → Settings → Environment Variables.
# Server-side only: never prefix with VITE_, or the key would be bundled into the public JavaScript.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-flash-latest, then gemini-2.5-flash).
GEMINI_MODEL=
